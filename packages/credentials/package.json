{
  "name": "@toon-protocol/credentials",
  "version": "0.1.0",
  "description": "The buyer's half of the credentials-issuer blind-signature protocol: blind k serials, unblind, verify.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toon-protocol/anytoon.git",
    "directory": "packages/credentials"
  },
  "homepage": "https://github.com/toon-protocol/anytoon/tree/main/packages/credentials#readme",
  "bugs": {
    "url": "https://github.com/toon-protocol/anytoon/issues"
  },
  "keywords": [
    "blind-signature",
    "rsabssa",
    "credentials",
    "anyone-protocol"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build --force",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test",
    "test": "node --test 'test/*.test.ts'"
  },
  "dependencies": {
    "@cloudflare/blindrsa-ts": "^0.4.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
