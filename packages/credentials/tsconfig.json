{
  "compilerOptions": {
    // Node 24 is the floor, so the emitted JS needs no downlevelling; what tsc
    // is here for is the .d.ts, which Node itself will never produce.
    "target": "es2023",
    "lib": ["es2023", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    // The source has to stay strippable by `node src/*.ts`, which is how this
    // repository runs it. Anything tsc would have to *emit* rather than erase
    // (enums, parameter properties, namespaces) is a build error here.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src"]
}
